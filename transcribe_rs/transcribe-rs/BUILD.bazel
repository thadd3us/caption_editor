load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("//transcribe_rs:version.bzl", "APP_VERSION")

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "transcribe-rs",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    edition = "2021",
    # Stamp APP_VERSION as `CARGO_PKG_VERSION` so clap's `--version` flag
    # reports the same release-tag string the GitHub Release uses. Bazel
    # doesn't go through cargo so rules_rust defaults this to "0.0.0";
    # set it explicitly here. Single source: //transcribe_rs:version.bzl.
    rustc_env = {"CARGO_PKG_VERSION": APP_VERSION},
    version = APP_VERSION,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        "//transcribe_rs/caption-schema:caption_schema",
        "//transcribe_rs/caption-core:caption_core",
    ],
    visibility = ["//visibility:public"],
)

# Hermetic unit tests for the CLI itself (arg parsing + the embed-step
# failure contract). Deliberately holds nothing that needs a model, the
# network, or ffmpeg, so it runs in default `bazel test //...`. The
# end-to-end behavior lives in //transcribe:transcribe_rs_parity_test,
# which is `manual` because it needs HF downloads.
rust_test(
    name = "transcribe_rs_test",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    crate = ":transcribe-rs",
    edition = "2021",
    rustc_env = {"CARGO_PKG_VERSION": APP_VERSION},
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + [
        "//transcribe_rs/caption-schema:caption_schema",
        "//transcribe_rs/caption-core:caption_core",
    ],
)
