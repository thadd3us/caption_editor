"""Repo-root Bzlmod module for caption-editor.

This is a polyglot project: Vue/Vite/TypeScript frontend, Electron main
process, Playwright E2E, and a Python `transcribe/` package with heavy
ML deps (torch, nemo-toolkit, pyannote). For this first pass Bazel is a
*test driver*, not a *build driver*:

  * The TS / Electron / Playwright builds remain owned by npm + Vite +
    electron-builder. `npm install` populates `node_modules/`.
  * The Python deps remain owned by `uv` + `transcribe/uv.lock`.
    `uv sync` populates `transcribe/.venv/`.
  * Bazel wraps the existing test commands as `sh_test` targets so
    `bazelisk test //...` becomes the canonical entrypoint and the
    shared disk cache (configured in .bazelrc) memoizes pass/fail
    across checkouts and CI.

Version policy mirrors mixed_up_files: prefer bazel_dep / toolchain
versions that have been out for at least 7 days at the time of pinning.

Follow-ups (intentionally deferred):
  * aspect_rules_js with a pnpm-lock.yaml derived from
    `pnpm import` against the existing package-lock.json — lets Bazel
    own node_modules and run vitest hermetically.
  * rules_python `pip.parse` over `transcribe/requirements.txt`
    (exported from uv.lock) — currently impractical because of the
    torch/nemo wheels, but the smaller post-processing test suite
    (`asr_results_to_captions_post_processing_pipeline_test.py`) is a
    fine starter target.
"""

module(
    name = "caption_editor",
    version = "0.0.0",
)

# Rules Shell — sh_binary / sh_test (split out of bazel core in 8/9).
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "platforms", version = "1.1.0")

# Rules Python — registers a hermetic Python 3.12 toolchain and
# ingests transcribe/requirements_bazel.txt (exported from uv.lock)
# into a `@py_pip` hub repo. Each py_test then depends only on the
# subset of packages it actually imports, so heavy wheels (torch,
# nemo-toolkit, pyannote-audio) only materialize when a test that
# transitively needs them is built.
#
# `transcribe/uv.lock` constrains python to ">=3.11,<3.13"; the
# matching toolchain is 3.12 (most recent in-range).
bazel_dep(name = "rules_python", version = "2.4.6")

PYTHON_VERSION = "3.12"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    # Without this, `bazel coverage //transcribe/...` runs the tests
    # under the coverage harness but every report comes back as
    # `LH:0 LF:0` because no instrumentation is actually installed.
    # rules_python wires in the `coverage` package from pip when this
    # is true. Requires `coverage` to be present in the pip lockfile
    # (it is — pulled in transitively as a test dep).
    configure_coverage_tool = True,
    is_default = True,
    python_version = PYTHON_VERSION,
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "py_pip",
    python_version = PYTHON_VERSION,
    requirements_lock = "//transcribe:requirements_bazel.txt",
)
use_repo(pip, "py_pip")

# aspect_rules_js — hermetic JS/TS toolchain. Backs the vitest /
# vue-tsc / eslint / playwright test targets in //:BUILD.bazel so they
# resolve packages against a Bazel-linked `node_modules/` derived from
# `pnpm-lock.yaml`, instead of whatever `npm install` left on the host.
#
# The source of truth for JS deps remains `package.json`. We keep
# `package-lock.json` so `npm install` still works for devs who haven't
# switched their inner loop to pnpm, and the matching `pnpm-lock.yaml`
# is generated by `pnpm import` (`pnpm` reads npm's lock and writes its
# own). Bumping any dep means re-running `pnpm import` to refresh
# pnpm-lock.yaml — otherwise the Bazel-linked tree will lag the npm one.
bazel_dep(name = "aspect_rules_js", version = "3.5.2")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    # `.npmrc` settings (legacy-peer-deps=true, etc.) must be visible
    # to pnpm during dep resolution; without this declaration
    # aspect_rules_js refuses to start.
    npmrc = "//:.npmrc",
    pnpm_lock = "//:pnpm-lock.yaml",
    # `@vue/test-utils` (used by every component-level vitest) does
    # `require("@vue/compiler-dom")` from its CJS entry point. In a
    # strict pnpm tree that require fails because compiler-dom is a
    # peer of vue and isn't hoisted to top-level node_modules. Lifting
    # it (and a few peers known to follow the same pattern) here gives
    # @vue/test-utils a stable resolution path without expanding the
    # full `public-hoist-pattern[]=*` net, which can interact badly
    # with aspect_rules_js's symlink graph.
    #
    # Each of these may be hoisted at exactly ONE version — aspect_rules_js
    # fails analysis outright on `multiple packages to hoist to
    # '/node_modules/@vue/compiler-dom'`. Nothing here pins the version, so
    # the single-version property has to hold in the lockfile instead: the
    # `overrides` block in package.json aliases @vue/compiler-{core,dom} and
    # @vue/shared to `$vue`. Without it, a transitive dep that asks for a
    # newer patch than the pinned `vue` (@vue/test-utils does exactly this)
    # puts two copies in the tree and breaks the build rather than any test.
    public_hoist_packages = {
        "@vue/compiler-dom": [""],
        "@vue/compiler-sfc": [""],
        "@vue/server-renderer": [""],
        "@vue/shared": [""],
        "@vue/reactivity": [""],
        "@vue/runtime-core": [""],
        "@vue/runtime-dom": [""],
    },
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")

# Re-export pnpm itself so `bazel run -- @pnpm install` works without
# requiring a host pnpm install — useful for refreshing pnpm-lock.yaml
# after editing package.json on a machine without nvm/pnpm.
pnpm = use_extension(
    "@aspect_rules_js//npm:extensions.bzl",
    "pnpm",
    dev_dependency = True,
)
use_repo(pnpm, "pnpm")

# rules_rust — host of the //transcribe_rs/ workspace (Rust replacement for
# the //transcribe/ Python ML pipeline; see transcribe_rs/SPIKE_NOTES.md).
#
# Toolchain: registers a hermetic rustc + cargo. We pin a single edition (2021)
# and a single channel (stable) across the workspace.
#
# Dep ingestion: crate_universe `from_cargo` reads transcribe_rs/Cargo.toml +
# transcribe_rs/Cargo.lock and synthesises @crates//<crate>: targets. This
# means Cargo.lock is the single source of truth for versions — bumping deps
# is `cargo update` in transcribe_rs/, then `bazel mod tidy` to refresh the
# resolved crate graph.
bazel_dep(name = "rules_rust", version = "0.75.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    # Pin via versions list; the workspace Cargo.toml's MSRV-equivalent is
    # whatever parakeet-rs + ort 2.0-rc accept.
    versions = ["1.99.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//transcribe_rs:Cargo.lock",
    # Only the workspace root is needed — `from_cargo` walks the workspace
    # `members` from there to discover per-crate manifests.
    manifests = ["//transcribe_rs:Cargo.toml"],
)

# whisper-rs-sys vendors whisper.cpp, which uses C++17 `std::filesystem`
# (`exists`, `directory_iterator`, etc.). Those APIs are gated on
# macOS 10.15+. Cargo on the host inherits MACOSX_DEPLOYMENT_TARGET from
# the user env (homebrew clang sets it to 11.0 by default); Bazel's
# sandbox doesn't, so without this annotation the cmake build fails
# with "'exists' is unavailable: introduced in macOS 10.15".
#
# CMAKE_{C,CXX}_FLAGS=-U__ARM_FEATURE_MATMUL_INT8 — whisper.cpp's
# ggml-cpu-quants.c uses `vmmlaq_s32` (an ARMv8.6 i8mm intrinsic)
# under `#ifdef __ARM_FEATURE_MATMUL_INT8`. On some Apple-silicon clang
# versions that macro is defined but the compiler isn't actually
# invoked with the i8mm feature flag, producing
# "always_inline function 'vmmlaq_s32' requires target feature 'i8mm'".
# We hit this on the GitHub macos-latest (macOS 14) runner but not on
# a local M-series box. Undefining the macro surgically disables the
# broken code path; the slower scalar fallback is selected at
# preprocess time. whisper-rs-sys's build.rs forwards any CMAKE_* env
# var to cmake as `-D<KEY>=<VALUE>`.
crate.annotation(
    build_script_env = {
        "MACOSX_DEPLOYMENT_TARGET": "11.0",
        "CMAKE_C_FLAGS": "-U__ARM_FEATURE_MATMUL_INT8",
        "CMAKE_CXX_FLAGS": "-U__ARM_FEATURE_MATMUL_INT8",
    },
    crate = "whisper-rs-sys",
)

# ort-sys links the ONNX Runtime that Bazel fetched (//tools/bazel:onnxruntime.bzl)
# rather than downloading its own. Its build script's download lands outside
# Bazel's view, in ~/Library/Caches, and a disk-cache hit on the script without
# that directory present fails the link -- the docstring there has the details.
#
# - ORT_LIB_LOCATION makes the script take its "user-provided" path, which skips
#   the download. rules_rust expands `$(execpath)` in build_script_env to an
#   *absolute* path (the script does not run from the execroot), and rewrites
#   it back to `${pwd}` in the link flags it hands downstream, so cached results
#   stay portable. Do not prefix it with `${pwd}` yourself: that doubles it, and
#   ort-sys then reports "could not link" as a `cargo::error` that Bazel does
#   NOT treat as a failure -- `ort_sys` still builds, with no library behind it.
# - compile_data, because rustc bundles the static library into the `ort_sys`
#   rlib and so needs the file as an input to *that* action too, not only to
#   the build script.
crate.annotation(
    build_script_data = ["@onnxruntime//:lib"],
    build_script_env = {"ORT_LIB_LOCATION": "$(execpath @onnxruntime//:lib)"},
    compile_data = ["@onnxruntime//:lib"],
    crate = "ort-sys",
    label_injections = {"@onnxruntime": "@onnxruntime"},
)
use_repo(crate, "crates")

onnxruntime = use_extension("//tools/bazel:onnxruntime.bzl", "onnxruntime")
use_repo(onnxruntime, "onnxruntime")
